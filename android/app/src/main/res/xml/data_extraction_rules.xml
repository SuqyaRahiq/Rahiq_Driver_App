<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and later. Keeps the auth box (access and refresh tokens, the
     driver's profile) out of Google Drive backups and phone-to-phone
     transfers, so a session never works on another device. Hive keeps its
     boxes in getFilesDir(), which is the "file" domain. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="authbox.hive" />
        <exclude domain="file" path="authbox.lock" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="authbox.hive" />
        <exclude domain="file" path="authbox.lock" />
    </device-transfer>
</data-extraction-rules>
